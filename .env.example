# Replace all example values before using this file outside local development.
DB_USER=ssp_owner
DB_PASSWORD=local-owner-password
DB_APP_PASSWORD=local-app-password
DB_NAME=ssp
DB_PORT=5432
APP_PORT=8080
WEB_PORT=8081
JWT_SECRET=replace-with-at-least-32-random-bytes
CORS_ALLOWED_ORIGINS=http://localhost:8081
COOKIE_SECURE=false
# Local prototype delivery only: active reset links appear in API logs.
PASSWORD_RESET_LOG_LINK=true
