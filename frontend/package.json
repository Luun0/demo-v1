{
  "name": "sen-support-platform-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "lint:contract": "redocly lint ../docs/openapi.yaml --config ../redocly.yaml",
    "gen:api": "openapi-typescript ../docs/openapi.yaml -o src/shared/api/schema.gen.ts",
    "check:api": "openapi-typescript ../docs/openapi.yaml -o /tmp/schema.check.ts && diff -q /tmp/schema.check.ts src/shared/api/schema.gen.ts",
    "size:bundle": "node scripts/bundle-budget.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@hookform/resolvers": "^6.0.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@tanstack/react-query": "^5.104.5",
    "i18next": "^26.5.10",
    "openapi-fetch": "^0.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.8",
    "react-router": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@redocly/cli": "^2.71.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.0.5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
